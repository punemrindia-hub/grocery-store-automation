{
  "name": "grocery-commerce-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev --workspace @grocery/api\" \"npm run dev --workspace @grocery/dashboard\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run build --workspace @grocery/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @grocery/database",
    "db:migrate": "npm run db:migrate --workspace @grocery/database",
    "db:seed": "npm run db:seed --workspace @grocery/database"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/bcryptjs": "^2.4.6",
    "typescript-eslint": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
