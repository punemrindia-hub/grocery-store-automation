generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  STAFF
}

enum ProductUnit {
  PCS
  KG
  GRAM
  LITRE
  ML
  PACK
  BOX
  DOZEN
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  PAYMENT_PENDING
  PAID
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FulfillmentType {
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  ONLINE
  UPI
  CASH
  CREDIT
}

enum PaymentStatus {
  PENDING
  INITIATED
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_PAID
  CASH
  CREDIT
}

enum LedgerType {
  DEBIT
  CREDIT
  PAYMENT
  REFUND
  ADJUSTMENT
  ORDER_CHARGE
  DISCOUNT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  STOCK_CORRECTION
}

model Shop {
  id String @id @default(cuid())
  name String
  slug String @unique
  phone String?
  timezone String @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings ShopSettings?
  users User[]
  customers Customer[]
  categories Category[]
  products Product[]
  inventoryTransactions InventoryTransaction[]
  orders Order[]
  carts Cart[]
  ledgerEntries LedgerEntry[]
  auditLogs AuditLog[]
  invoices Invoice[]
  whatsappMessages WhatsAppMessage[]
  @@index([createdAt])
}

model ShopSettings {
  id String @id @default(cuid())
  shopId String @unique
  invoicePrefix String @default("INV")
  orderPrefix String @default("GRC")
  currency String @default("INR")
  taxEnabled Boolean @default(false)
  creditAllowed Boolean @default(true)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model User {
  id String @id @default(cuid())
  shopId String
  email String
  name String
  passwordHash String
  role UserRole @default(STAFF)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]
  @@unique([shopId, email])
  @@index([shopId])
}

model Customer {
  id String @id @default(cuid())
  shopId String
  name String
  whatsappNumber String
  email String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]
  carts Cart[]
  conversations Conversation[]
  addresses CustomerAddress[]
  ledgerEntries LedgerEntry[]
  @@unique([shopId, whatsappNumber])
  @@index([shopId, createdAt])
}

model CustomerAddress {
  id String @id @default(cuid())
  customerId String
  label String
  addressLine1 String
  addressLine2 String?
  city String
  postalCode String
  isDefault Boolean @default(false)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Category {
  id String @id @default(cuid())
  shopId String
  name String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]
  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id String @id @default(cuid())
  shopId String
  categoryId String
  name String
  sku String
  barcode String?
  unit ProductUnit
  sellingPrice Decimal @db.Decimal(12, 2)
  costPrice Decimal @db.Decimal(12, 2)
  taxRate Decimal @default(0) @db.Decimal(5, 2)
  stockQuantity Decimal @default(0) @db.Decimal(12, 3)
  minimumStock Decimal @default(0) @db.Decimal(12, 3)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  cartItems CartItem[]
  inventoryTransactions InventoryTransaction[]
  @@unique([shopId, sku])
  @@index([shopId, categoryId])
}

model Cart {
  id String @id @default(cuid())
  shopId String
  customerId String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items CartItem[]
  @@index([shopId, customerId, isActive])
}

model CartItem {
  id String @id @default(cuid())
  cartId String
  productId String
  quantity Decimal @db.Decimal(12, 3)
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([cartId, productId])
}

model InventoryTransaction {
  id String @id @default(cuid())
  shopId String
  productId String
  type InventoryTransactionType
  quantity Decimal @db.Decimal(12, 3)
  unitCost Decimal? @db.Decimal(12, 2)
  reference String?
  createdBy String?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([shopId, productId, createdAt])
}

model Order {
  id String @id @default(cuid())
  shopId String
  customerId String
  orderNumber String
  status OrderStatus @default(DRAFT)
  source String @default("DASHBOARD")
  fulfillmentType FulfillmentType @default(TAKEAWAY)
  idempotencyKey String?
  paymentMethod PaymentMethod?
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  items OrderItem[]
  invoice Invoice?
  payments Payment[]
  ledgerEntries LedgerEntry[]
  @@unique([shopId, orderNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, status])
  @@index([shopId, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  nameSnapshot String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity Decimal @db.Decimal(12, 3)
  lineTotal Decimal @db.Decimal(12, 2)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id String @id @default(cuid())
  shopId String
  customerId String
  orderId String?
  amount Decimal @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  provider String?
  providerPaymentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order? @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]
  @@index([shopId, createdAt])
}

model PaymentTransaction {
  id String @id @default(cuid())
  paymentId String
  providerEventId String? @unique
  type String
  amount Decimal @db.Decimal(12, 2)
  rawPayload Json?
  createdAt DateTime @default(now())
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id String @id @default(cuid())
  shopId String
  customerId String
  orderId String?
  paymentId String?
  type LedgerType
  direction LedgerDirection
  amount Decimal @db.Decimal(12, 2)
  description String
  reference String?
  createdAt DateTime @default(now())
  createdBy String?
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  @@index([shopId, customerId, createdAt])
}

model Invoice {
  id String @id @default(cuid())
  shopId String
  orderId String @unique
  invoiceNumber String
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  amountPending Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])
  @@unique([shopId, invoiceNumber])
}

model WhatsAppMessage {
  id String @id @default(cuid())
  shopId String
  customerId String
  orderId String?
  direction String
  messageType String
  recipient String
  body String
  provider String @default("mock")
  providerMessageId String?
  status String @default("QUEUED")
  createdAt DateTime @default(now())
  sentAt DateTime?
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([shopId, customerId, createdAt])
  @@unique([provider, providerMessageId])
}

model Conversation {
  id String @id @default(cuid())
  shopId String
  customerId String
  state String
  cartId String?
  metadata Json?
  lastMessageAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@unique([shopId, customerId])
}

model AuditLog {
  id String @id @default(cuid())
  shopId String
  userId String?
  action String
  entity String
  entityId String
  before Json?
  after Json?
  ipAddress String?
  createdAt DateTime @default(now())
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  @@index([shopId, createdAt])
}
